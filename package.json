{
  "name": "bcr32-studio",
  "version": "0.8.0",
  "private": true,
  "description": "Browser editor for the Behringer BCR32 MIDI controller (Web MIDI): live front panel, assignments, MIDI Learn, presets, PDF overlays, Cubase MIDI Remote export.",
  "scripts": {
    "midi": "node scripts/bcr32-midi.cjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc -b --noEmit",
    "leak-gate": "node scripts/leak-gate.mjs"
  },
  "dependencies": {
    "@julusian/midi": "3.8.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "wrangler": "4.149.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bcr32-studio/bcr32-studio.github.io.git"
  }
}
