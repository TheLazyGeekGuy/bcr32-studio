{
  "name": "bcr32-studio",
  "version": "0.46.0-alpha.7",
  "private": true,
  "description": "BCR32 editor with firmware 1.0.3 sequencer integration, shared MIDI Studio tools and preset library.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "modules:generate": "node scripts/generate-editor-registrations.mjs",
    "predev": "npm run modules:generate",
    "prebuild": "npm run modules:generate",
    "typecheck": "tsc -b --noEmit",
    "build": "tsc -b && vite build && node scripts/verify-distribution.mjs dist",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node scripts/run-tests.mjs",
    "leak-gate": "node scripts/leak-gate.mjs",
    "midi": "node scripts/bcr32-midi.cjs",
    "build:sysex-map-sdk": "node scripts/build-sysex-map-sdk.mjs"
  },
  "dependencies": {
    "@julusian/midi": "3.8.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "toolcool-range-slider": "4.0.28"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "wrangler": "4.151.3",
    "esbuild": "0.28.2",
    "marked": "18.1.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheLazyGeekGuy/bcr32-studio.git"
  },
  "homepage": "https://thelazygeekguy.github.io/bcr32-studio/"
}
